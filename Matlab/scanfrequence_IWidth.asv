clc;
clear;
close all;


%这个matlab函数用于电流环数据扫频分析带宽，相位裕度，阻尼比。需要传入的数据是
%1、sample_index  2、freq_hz  3、iq_ref  4、iq_now
%对于不同PI参数下的数据只需要修改数据文件来生成对应频域分析图

%% =========================
% 用户参数
% =========================
Fs = 20000;                            % 控制/采样频率 Hz
file = 'scan_100_4000hz_PI900.csv';   % VOFA导出文件
discard_ratio = 0.30;                  % 每个频点丢弃前30%过渡段
min_points = 20;                       % 每个频点最少点数

%% =========================
% 读取数据
% =========================
M = readmatrix(file);

M = M(~any(isnan(M),2), :);            % 删除 NaN 行
M = M(~all(abs(M) < 1e-12, 2), :);     % 删除全0行

if size(M,2) < 4
    error('数据列数不足，至少需要4列：I0,I1,I2,I3');
end

sample_index = M(:,1);   % I0
freq_hz      = M(:,2);   % I1
iq_ref       = M(:,3);   % I2
iq_now       = M(:,4);   % I3

valid_row = freq_hz > 0;
sample_index = sample_index(valid_row);
freq_hz      = freq_hz(valid_row);
iq_ref       = iq_ref(valid_row);
iq_now       = iq_now(valid_row);

freq_list_all = unique(freq_hz);
freq_list_all = sort(freq_list_all);
n_freq_all = length(freq_list_all);

if isempty(freq_list_all)
    error('没有有效扫频数据，请检查CSV内容。');
end

%% =========================
% 逐频点分析
% =========================
gain_arr        = nan(n_freq_all,1);
gain_dB_arr     = nan(n_freq_all,1);
phase_rad_arr   = nan(n_freq_all,1);
ain_arr         = nan(n_freq_all,1);
aout_arr        = nan(n_freq_all,1);
sample_num_arr  = nan(n_freq_all,1);

% 闭环复频响 T(jw)
Tjw_arr         = nan(n_freq_all,1) + 1j*nan(n_freq_all,1);

% 顶图拼接缓存
x_wave_all = [];
u_wave_all = [];
y_wave_all = [];
freq_wave_all = [];
seg_mid = zeros(n_freq_all,1);

cursor = 0;

for k = 1:n_freq_all
    f0 = freq_list_all(k);

    idx = abs(freq_hz - f0) < 1e-9;

    n = sample_index(idx);
    u = iq_ref(idx);
    y = iq_now(idx);

    sample_num_arr(k) = length(n);

    if length(n) < min_points
        continue;
    end

    t = n / Fs;

    [t, sort_idx] = sort(t);
    u = u(sort_idx);
    y = y(sort_idx);

    % 去掉前面过渡段
    N = length(t);
    idx0 = floor(N * discard_ratio) + 1;

    t = t(idx0:end);
    u = u(idx0:end);
    y = y(idx0:end);

    if length(t) < min_points
        continue;
    end

    % -------------------------
    % 顶图提取"1个周期"
    % -------------------------
    cycle_points = max(round(Fs / f0), 2);

    if length(t) >= cycle_points
        u1 = u(end-cycle_points+1:end);
        y1 = y(end-cycle_points+1:end);

        x1 = (cursor : cursor + cycle_points - 1).';
        x_wave_all = [x_wave_all; x1];
        u_wave_all = [u_wave_all; u1];
        y_wave_all = [y_wave_all; y1];
        freq_wave_all = [freq_wave_all; repmat(f0, cycle_points, 1)];

        seg_mid(k) = mean(x1);
        cursor = cursor + cycle_points;
    end

    % -------------------------
    % 频响分析
    % -------------------------
    u_ac = u - mean(u);
    y_ac = y - mean(y);

    w0 = 2*pi*f0;
    c = cos(w0 * t);
    s = sin(w0 * t);

    Uc = 2/length(t) * sum(u_ac .* c);
    Us = 2/length(t) * sum(u_ac .* s);
    Yc = 2/length(t) * sum(y_ac .* c);
    Ys = 2/length(t) * sum(y_ac .* s);

    Ain  = sqrt(Uc^2 + Us^2);
    Aout = sqrt(Yc^2 + Ys^2);

    if Ain < 1e-12
        continue;
    end

    ph_in  = atan2(Uc, Us);
    ph_out = atan2(Yc, Ys);

    gain = Aout / Ain;
    gain_dB = 20 * log10(gain);
    phase_rad = ph_out - ph_in;

    % 闭环复频响 T(jw)
    Tjw = gain * exp(1j * phase_rad);

    gain_arr(k)      = gain;
    gain_dB_arr(k)   = gain_dB;
    phase_rad_arr(k) = phase_rad;
    ain_arr(k)       = Ain;
    aout_arr(k)      = Aout;
    Tjw_arr(k)       = Tjw;
end

%% =========================
% 清理无效频点
% =========================
valid = ~isnan(gain_dB_arr) & ~isnan(phase_rad_arr) & ~isnan(real(Tjw_arr));

freq_list      = freq_list_all(valid);
gain_arr       = gain_arr(valid);
gain_dB_arr    = gain_dB_arr(valid);
phase_rad_arr  = phase_rad_arr(valid);
ain_arr        = ain_arr(valid);
aout_arr       = aout_arr(valid);
sample_num_arr = sample_num_arr(valid);
seg_mid_valid  = seg_mid(valid);
Tjw_arr        = Tjw_arr(valid);

if isempty(freq_list)
    error('没有可用于Bode分析的有效频点。');
end

%% =========================
% 闭环相位展开
% =========================
phase_rad_arr = unwrap(phase_rad_arr);
phase_deg_arr = phase_rad_arr * 180/pi;

%% =========================
% -3dB 带宽（闭环）
% =========================
bw_hz = NaN;
for k = 2:length(freq_list)
    if gain_dB_arr(k-1) >= -3 && gain_dB_arr(k) <= -3
        f1 = freq_list(k-1);
        f2 = freq_list(k);
        g1 = gain_dB_arr(k-1);
        g2 = gain_dB_arr(k);

        bw_hz = f1 + (-3 - g1) * (f2 - f1) / (g2 - g1);
        break;
    end
end

%% =========================
% 由闭环频响重构等效开环频响 L = T / (1 - T)
% =========================
Ljw_arr = Tjw_arr ./ (1 - Tjw_arr);

L_mag = abs(Ljw_arr);
L_gain_dB = 20 * log10(L_mag);

L_phase_rad = unwrap(angle(Ljw_arr));
L_phase_deg = L_phase_rad * 180/pi;

%% =========================
% 开环增益交越频率与相位裕度
% =========================
pm_deg = NaN;
pm_freq_hz = NaN;
phase_at_gc_deg = NaN;

for k = 2:length(freq_list)
    % 找 |L| = 1 (0dB) 交越点
    if (L_gain_dB(k-1) >= 0 && L_gain_dB(k) <= 0) || ...
       (L_gain_dB(k-1) <= 0 && L_gain_dB(k) >= 0)

        f1 = freq_list(k-1);
        f2 = freq_list(k);
        g1 = L_gain_dB(k-1);
        g2 = L_gain_dB(k);

        if abs(g2 - g1) < 1e-12
            pm_freq_hz = f1;
            phase_at_gc_deg = L_phase_deg(k-1);
        else
            pm_freq_hz = f1 + (0 - g1) * (f2 - f1) / (g2 - g1);

            p1 = L_phase_deg(k-1);
            p2 = L_phase_deg(k);
            phase_at_gc_deg = p1 + (pm_freq_hz - f1) * (p2 - p1) / (f2 - f1);
        end

        pm_deg = 180 + phase_at_gc_deg;
        break;
    end
end

%% =========================
% 由相位裕度估算等效阻尼比（主导二阶近似）
% =========================
zeta_est = NaN;
if ~isnan(pm_deg) && pm_deg > 0 && pm_deg < 85
    zeta_est = estimate_zeta_from_pm(pm_deg);
end

%% =========================
% 打印结果
% =========================
fprintf('================ 扫频分析结果 ================\n');
fprintf('扫频范围: %.1f Hz ~ %.1f Hz\n', min(freq_list), max(freq_list));
fprintf('有效频点数: %d\n', length(freq_list));

if ~isnan(bw_hz)
    fprintf('闭环带宽: %.2f Hz (-3 dB)\n', bw_hz);
else
    fprintf('当前扫频范围内未找到闭环 -3 dB 交点\n');
end

if ~isnan(pm_deg)
    fprintf('等效开环增益交越频率: %.2f Hz\n', pm_freq_hz);
    fprintf('相位裕度 PM: %.2f deg\n', pm_deg);
else
    fprintf('当前扫频范围内未找到等效开环 0 dB 交越点，无法计算相位裕度\n');
end

if ~isnan(zeta_est)
    fprintf('等效主导二阶阻尼比 zeta: %.4f\n', zeta_est);
else
    fprintf('无法可靠估算阻尼比（可能PM无效或超出近似适用范围）\n');
end

result_table = table(freq_list, sample_num_arr, gain_arr, gain_dB_arr, phase_deg_arr, ...
    L_gain_dB, L_phase_deg, ...
    'VariableNames', {'Freq_Hz','SampleNum','Gain','Gain_dB','Phase_deg','LoopGain_dB','LoopPhase_deg'});
disp(result_table);

%% =========================
% 绘图
% =========================
fig = figure('Color','w','Position',[120 20 1280 1050]);

% -------- 图1：每个频率取1个周期后拼接 --------
subplot(4,1,1);
plot(x_wave_all, u_wave_all, 'b', 'LineWidth', 0.8); hold on;
plot(x_wave_all, y_wave_all, 'r', 'LineWidth', 0.8);
grid on;
xlabel('采样点');
ylabel('电流 (A)');
title(sprintf('实时波形: %.1f~%.1f Hz', min(freq_list), max(freq_list)));
legend('Iq指令', 'Iq实测', 'Location', 'best');

% -------- 图2：闭环增益 --------
subplot(4,1,2);
semilogx(freq_list, gain_dB_arr, 'o-b', 'LineWidth', 1.5, 'MarkerSize', 5); hold on;
grid on;
xlabel('频率 (Hz)');
ylabel('增益 (dB)');
if ~isnan(bw_hz) && ~isnan(pm_deg) && ~isnan(zeta_est)
    title(sprintf('闭环 Bode 图 - 增益  |  BW=%.1f Hz, PM=%.1f deg, \\zeta=%.3f', ...
        bw_hz, pm_deg, zeta_est));
else
    title('闭环 Bode 图 - 增益');
end

h1 = yline(-3, '--', '-3dB', ...
    'Color', [0.90 0.35 0.35], ...
    'LineWidth', 1.2);
h1.Annotation.LegendInformation.IconDisplayStyle = 'off';

if ~isnan(bw_hz)
    h2 = xline(bw_hz, '--', sprintf('BW=%.1fHz', bw_hz), ...
        'Color', [0.1 0.8 0.1], ...
        'LineWidth', 1.2, ...
        'LabelOrientation', 'horizontal', ...
        'LabelVerticalAlignment', 'middle');
    h2.Annotation.LegendInformation.IconDisplayStyle = 'off';
end

xlim([min(freq_list), max(freq_list)]);

% -------- 图3：闭环相位 --------
subplot(4,1,3);
semilogx(freq_list, phase_deg_arr, 'o-m', 'LineWidth', 1.5, 'MarkerSize', 5); hold on;
grid on;
xlabel('频率 (Hz)');
ylabel('相位 (deg)');
title('闭环 Bode 图 - 相位');

xlim([min(freq_list), max(freq_list)]);

% -------- 图4：等效开环相位 --------
subplot(4,1,4);
semilogx(freq_list, L_phase_deg, 'o-r', 'LineWidth', 1.5, 'MarkerSize', 5); hold on;
grid on;
xlabel('频率 (Hz)');
ylabel('相位 (deg)');
title('等效开环 Bode 图 - 相位');

h3 = yline(-180, '--', '-180deg', ...
    'Color', [0.5 0.5 0.5], ...
    'LineWidth', 1.0);
h3.Annotation.LegendInformation.IconDisplayStyle = 'off';

if ~isnan(pm_deg)
    h4 = xline(pm_freq_hz, '--', sprintf('PM频率=%.1fHz', pm_freq_hz), ...
        'Color', [0.1 0.6 0.1], ...
        'LineWidth', 1.2, ...
        'LabelOrientation', 'horizontal', ...
        'LabelVerticalAlignment', 'middle');
    h4.Annotation.LegendInformation.IconDisplayStyle = 'off';

    plot(pm_freq_hz, phase_at_gc_deg, 'ks', 'MarkerFaceColor', 'y', 'MarkerSize', 7);

    txt = sprintf('PM = %.2f deg', pm_deg);
    text(pm_freq_hz, phase_at_gc_deg, ['  ' txt], ...
        'Color', [0.15 0.15 0.15], ...
        'FontSize', 10, ...
        'VerticalAlignment', 'bottom');
end

if ~isnan(zeta_est)
    text(freq_list(round(end*0.70)), min(L_phase_deg)+10, ...
        sprintf('\\zeta_{eq} = %.4f', zeta_est), ...
        'Color', [0.2 0.2 0.8], ...
        'FontSize', 11, ...
        'FontWeight', 'bold');
end

xlim([min(freq_list), max(freq_list)]);

%% =========================
% 自定义 Data Cursor
% =========================
dcm = datacursormode(fig);
set(dcm, 'Enable', 'on', 'UpdateFcn', @(~, event_obj) topWaveformDataTip(event_obj, x_wave_all, freq_wave_all, u_wave_all, y_wave_all));

%% =========================
% 本地函数
% =========================
function txt = topWaveformDataTip(event_obj, x_all, f_all, u_all, y_all)
    pos = event_obj.Position;
    xq = pos(1);

    [~, idx] = min(abs(x_all - xq));

    txt = {
        ['采样点: ', num2str(x_all(idx))], ...
        ['频率: ', num2str(f_all(idx), '%.3f'), ' Hz'], ...
        ['Iq指令: ', num2str(u_all(idx), '%.6f'), ' A'], ...
        ['Iq实测: ', num2str(y_all(idx), '%.6f'), ' A']
        };
end

function zeta = estimate_zeta_from_pm(pm_deg)
    target = pm_deg;

    f = @(z) rad2deg(atan(2*z ./ sqrt(sqrt(1 + 4*z.^4) - 2*z.^2))) - target;

    z_low = 0.01;
    z_high = 2.0;

    if f(z_low) * f(z_high) > 0
        zeta = NaN;
        return;
    end

    zeta = fzero(f, [z_low, z_high]);
end